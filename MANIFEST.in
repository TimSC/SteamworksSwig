include LICENSE
include THIRD_PARTY_NOTICES.md
include README.md
include MANIFEST.in
include pyproject.toml
include setup.py
include *.py
include *.md
include go.mod
include go/steamworks/*.go
recursive-include examples *.go *.py
recursive-include python *.py
recursive-include tools *.py *.in

# Valve permits redistribution of redistributable_bin with Licensee Software,
# but the source distribution intentionally contains no Valve SDK material.
prune sdk
prune sdk_*
prune generated
exclude go/steamworks/generated.go
prune go/steamworks/raw
prune build
prune dist
prune *.egg-info
global-exclude *.py[cod]
global-exclude __pycache__
