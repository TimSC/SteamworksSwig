#pragma once

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#if defined( _WIN32 ) && defined( SWS_BUILD_SHARED )
#define SWS_API __declspec( dllexport )
#elif defined( __GNUC__ )
#define SWS_API __attribute__ ((visibility("default")))
#else
#define SWS_API
#endif

#ifdef __cplusplus
extern "C" {
#endif

typedef struct SWS_String
{
	const char *data;
	size_t size;
} SWS_String;

typedef struct SWS_StringList
{
	SWS_String *items;
	size_t size;
} SWS_StringList;

typedef struct SWS_Bytes
{
	const uint8_t *data;
	size_t size;
} SWS_Bytes;

typedef struct SWS_BytesList
{
	SWS_Bytes *items;
	size_t size;
} SWS_BytesList;

SWS_API void SWS_FreeString( SWS_String value );
SWS_API void SWS_FreeStringList( SWS_StringList value );
SWS_API void SWS_FreeBytes( SWS_Bytes value );
SWS_API void SWS_FreeBytesList( SWS_BytesList value );

{{ c_declarations }}

#ifdef __cplusplus
}
#endif
