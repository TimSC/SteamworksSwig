int Steam_GameServer_BeginAuthSessionBytes( const uint8_t * data, size_t dataSize, uint64_steamid steamID )
{
	auto *server = SteamAPI_SteamGameServer();
	if ( !server || ( !data && dataSize > 0 ) || dataSize > static_cast<size_t>( INT32_MAX ) )
	{
