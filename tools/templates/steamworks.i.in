%module steamworks

%{
#include "steamworks_c_api.h"
#include <steam/steam_api.h>
%}

%include "stdint.i"

%typemap(out) SWS_String {
    $result = PyUnicode_FromStringAndSize($1.data ? $1.data : "", static_cast<Py_ssize_t>($1.size));
    SWS_FreeString($1);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(out) SWS_StringList {
    PyObject *list = PyList_New(static_cast<Py_ssize_t>($1.size));
    if (!list) {
        SWS_FreeStringList($1);
        SWIG_fail;
    }
    for (size_t i = 0; i < $1.size; ++i) {
        SWS_String item = $1.items[i];
        PyObject *text = PyUnicode_FromStringAndSize(item.data ? item.data : "", static_cast<Py_ssize_t>(item.size));
        if (!text) {
            Py_DECREF(list);
            SWS_FreeStringList($1);
            SWIG_fail;
        }
        PyList_SET_ITEM(list, static_cast<Py_ssize_t>(i), text);
    }
    SWS_FreeStringList($1);
    $result = list;
}

%typemap(out) SWS_Bytes {
    $result = PyBytes_FromStringAndSize(reinterpret_cast<const char *>($1.data), static_cast<Py_ssize_t>($1.size));
    SWS_FreeBytes($1);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(out) SWS_BytesList {
    PyObject *list = PyList_New(static_cast<Py_ssize_t>($1.size));
    if (!list) {
        SWS_FreeBytesList($1);
        SWIG_fail;
    }
    for (size_t i = 0; i < $1.size; ++i) {
        SWS_Bytes item = $1.items[i];
        PyObject *bytes = PyBytes_FromStringAndSize(reinterpret_cast<const char *>(item.data), static_cast<Py_ssize_t>(item.size));
        if (!bytes) {
            Py_DECREF(list);
            SWS_FreeBytesList($1);
            SWIG_fail;
        }
        PyList_SET_ITEM(list, static_cast<Py_ssize_t>(i), bytes);
    }
    SWS_FreeBytesList($1);
    $result = list;
}

%typemap(in) (const uint8_t * data, size_t dataSize) (char *buffer = 0, Py_ssize_t buffer_size = 0) {
    if (!PyBytes_Check($input)) {
        SWIG_exception_fail(SWIG_TypeError, "expected bytes");
    }
    if (PyBytes_AsStringAndSize($input, &buffer, &buffer_size) == -1) {
        SWIG_fail;
    }
    $1 = const_cast<uint8_t *>(reinterpret_cast<const uint8_t *>(buffer));
    $2 = static_cast<size_t>(buffer_size);
}

%typemap(typecheck) (const uint8_t * data, size_t dataSize) {
    $1 = PyBytes_Check($input) ? 1 : 0;
}

%typemap(in, numinputs=0) (uint64_t *handlesOut, size_t capacity, size_t *countOut)
    (uint64_t handles[STEAM_INPUT_MAX_COUNT], size_t count = 0) {
    $1 = handles;
    $2 = STEAM_INPUT_MAX_COUNT;
    $3 = &count;
}

%typemap(argout) (uint64_t *handlesOut, size_t capacity, size_t *countOut) {
    PyObject *controllers = PyTuple_New(static_cast<Py_ssize_t>(*$3));
    if (!controllers) {
        SWIG_fail;
    }
    for (size_t i = 0; i < *$3; ++i) {
        PyObject *handle = PyLong_FromUnsignedLongLong($1[i]);
        if (!handle) {
            Py_DECREF(controllers);
            SWIG_fail;
        }
        PyTuple_SET_ITEM(controllers, static_cast<Py_ssize_t>(i), handle);
    }
    Py_DECREF($result);
    $result = controllers;
}

%typemap(in, numinputs=0) (bool *activeOut, bool *pressedOut)
    (bool active = false, bool pressed = false) {
    $1 = &active;
    $2 = &pressed;
}

%typemap(argout) (bool *activeOut, bool *pressedOut) {
    Py_DECREF($result);
    $result = Py_BuildValue("(OO)", *$1 ? Py_True : Py_False, *$2 ? Py_True : Py_False);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(in, numinputs=0) (bool *activeOut, int32_t *modeOut, float *xOut, float *yOut)
    (bool active = false, int32_t mode = 0, float x = 0, float y = 0) {
    $1 = &active;
    $2 = &mode;
    $3 = &x;
    $4 = &y;
}

%typemap(argout) (bool *activeOut, int32_t *modeOut, float *xOut, float *yOut) {
    Py_DECREF($result);
    $result = Py_BuildValue("(Oiff)", *$1 ? Py_True : Py_False, static_cast<int>(*$2), *$3, *$4);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(in, numinputs=0) (int32_t *originsOut, size_t capacity, size_t *countOut)
    (int32_t origins[STEAM_INPUT_MAX_ORIGINS], size_t count = 0) {
    $1 = origins;
    $2 = STEAM_INPUT_MAX_ORIGINS;
    $3 = &count;
}

%typemap(argout) (int32_t *originsOut, size_t capacity, size_t *countOut) {
    Py_DECREF($result);
    $result = PyTuple_New(static_cast<Py_ssize_t>(*$3));
    if (!$result) {
        SWIG_fail;
    }
    for (size_t i = 0; i < *$3; ++i) {
        PyObject *origin = PyLong_FromLong($1[i]);
        if (!origin) {
            Py_CLEAR($result);
            SWIG_fail;
        }
        PyTuple_SET_ITEM($result, static_cast<Py_ssize_t>(i), origin);
    }
}

%typemap(in, numinputs=0) (uint32_t *firstOut, uint32_t *secondOut)
    (uint32_t first = 0, uint32_t second = 0) {
    $1 = &first;
    $2 = &second;
}

%typemap(argout) (uint32_t *firstOut, uint32_t *secondOut) {
    Py_DECREF($result);
    $result = Py_BuildValue("(II)", static_cast<unsigned int>(*$1), static_cast<unsigned int>(*$2));
    if (!$result) {
        SWIG_fail;
    }
}

%include "steamworks_c_api.h"
