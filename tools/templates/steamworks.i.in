%module steamworks

%{
#include "steamworks_c_api.h"
%}

%include "stdint.i"

%typemap(out) SWS_String {
    $result = PyUnicode_FromStringAndSize($1.data ? $1.data : "", static_cast<Py_ssize_t>($1.size));
    SWS_FreeString($1);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(out) SWS_StringList {
    PyObject *list = PyList_New(static_cast<Py_ssize_t>($1.size));
    if (!list) {
        SWS_FreeStringList($1);
        SWIG_fail;
    }
    for (size_t i = 0; i < $1.size; ++i) {
        SWS_String item = $1.items[i];
        PyObject *text = PyUnicode_FromStringAndSize(item.data ? item.data : "", static_cast<Py_ssize_t>(item.size));
        if (!text) {
            Py_DECREF(list);
            SWS_FreeStringList($1);
            SWIG_fail;
        }
        PyList_SET_ITEM(list, static_cast<Py_ssize_t>(i), text);
    }
    SWS_FreeStringList($1);
    $result = list;
}

%typemap(out) SWS_Bytes {
    $result = PyBytes_FromStringAndSize(reinterpret_cast<const char *>($1.data), static_cast<Py_ssize_t>($1.size));
    SWS_FreeBytes($1);
    if (!$result) {
        SWIG_fail;
    }
}

%typemap(out) SWS_BytesList {
    PyObject *list = PyList_New(static_cast<Py_ssize_t>($1.size));
    if (!list) {
        SWS_FreeBytesList($1);
        SWIG_fail;
    }
    for (size_t i = 0; i < $1.size; ++i) {
        SWS_Bytes item = $1.items[i];
        PyObject *bytes = PyBytes_FromStringAndSize(reinterpret_cast<const char *>(item.data), static_cast<Py_ssize_t>(item.size));
        if (!bytes) {
            Py_DECREF(list);
            SWS_FreeBytesList($1);
            SWIG_fail;
        }
        PyList_SET_ITEM(list, static_cast<Py_ssize_t>(i), bytes);
    }
    SWS_FreeBytesList($1);
    $result = list;
}

%typemap(in) (const uint8_t * data, size_t dataSize) (char *buffer = 0, Py_ssize_t buffer_size = 0) {
    if (!PyBytes_Check($input)) {
        SWIG_exception_fail(SWIG_TypeError, "expected bytes");
    }
    if (PyBytes_AsStringAndSize($input, &buffer, &buffer_size) == -1) {
        SWIG_fail;
    }
    $1 = const_cast<uint8_t *>(reinterpret_cast<const uint8_t *>(buffer));
    $2 = static_cast<size_t>(buffer_size);
}

%typemap(typecheck) (const uint8_t * data, size_t dataSize) {
    $1 = PyBytes_Check($input) ? 1 : 0;
}

%include "steamworks_c_api.h"
